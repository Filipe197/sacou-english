{
 "como-se-diz-eu-quero": {
  "titulo": "Como se diz “eu quero” em inglês?",
  "descricao": "\"Eu quero\" em inglês é \"I want\" (fala-se ái uánt). Veja exemplos com áudio, o jeito educado de pedir e o erro que todo brasileiro comete.",
  "tema": "Frases do dia a dia",
  "resposta": {
   "pt": "Eu quero",
   "en": "I want",
   "fala": "ái uánt",
   "voz": "ana"
  },
  "explica": "Want quer dizer querer. Serve para coisas (I want coffee) e para ações. Quando vem outro verbo depois, ele ganha um to na frente: I want to sleep, eu quero dormir.",
  "exemplos": [
   {
    "en": "I want coffee.",
    "pt": "Eu quero café.",
    "voz": "ana"
   },
   {
    "en": "I want to travel.",
    "pt": "Eu quero viajar.",
    "voz": "tom"
   },
   {
    "en": "I want a new phone.",
    "pt": "Eu quero um celular novo.",
    "voz": "ana"
   },
   {
    "en": "I don't want to go.",
    "pt": "Eu não quero ir.",
    "voz": "tom"
   },
   {
    "en": "Do you want some water?",
    "pt": "Você quer água?",
    "voz": "ana"
   }
  ],
  "dica": {
   "titulo": "No restaurante, peça com I'd like",
   "texto": "I want é certo, mas num pedido soa meio seco, como \"eu quero isso aí\". Para pedir com educação, o nativo usa I'd like (eu gostaria).",
   "en": "I'd like a coffee, please.",
   "pt": "Eu gostaria de um café, por favor.",
   "fala": "áid láik a cófi, plíiz",
   "voz": "tom"
  },
  "erros": [
   {
    "errado": "I want that you come.",
    "certo": "I want you to come.",
    "pt": "Eu quero que você venha.",
    "porque": "Em inglês não existe \"quero que\". A pessoa vem logo depois de want, e a ação vem com to."
   },
   {
    "errado": "I want sleep.",
    "certo": "I want to sleep.",
    "pt": "Eu quero dormir.",
    "porque": "Verbo depois de want sempre leva to."
   }
  ],
