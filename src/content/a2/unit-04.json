 "guide": {
  "title": "Presente contínuo (estou fazendo)",
  "intro": "Para o que está acontecendo AGORA, o inglês usa am/is/are + verbo com -ING. É o nosso \"estou fazendo\", \"está chovendo\".",
  "points": [
   {
    "en": "I am reading a book.",
    "pt": "Eu estou lendo um livro.",
    "note": "am/is/are + verbo-ing."
   },
   {
    "en": "It's raining now.",
    "pt": "Está chovendo agora.",
    "note": "Forma curta: I'm, you're, he's, she's, it's, we're, they're."
   },
   {
    "en": "She isn't working at the moment.",
    "pt": "Ela não está trabalhando no momento.",
    "note": "Negativa: isn't / aren't / I'm not."
   },
   {
    "en": "Are you listening?",
    "pt": "Você está ouvindo?",
    "note": "Pergunta: am/is/are vai para o começo."
   },
   {
    "en": "I work every day. I'm working now.",
    "pt": "Eu trabalho todo dia. Estou trabalhando agora.",
    "note": "Rotina = presente simples. Agora = presente contínuo."
   }
  ],
  "tips": [
   "Verbos terminados em -e perdem o e: make → making, write → writing.",
   "Alguns dobram a consoante: swim → swimming, run → running, sit → sitting."
  ]
 },
