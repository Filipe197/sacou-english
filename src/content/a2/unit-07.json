 "guide": {
  "title": "Contáveis, incontáveis e preços",
  "intro": "Em inglês algumas coisas são contáveis (one apple, two apples) e outras não (water, money, rice). Isso muda as palavras que usamos para quantidade.",
  "points": [
   {
    "en": "There are some apples. Is there any milk?",
    "pt": "Tem algumas maçãs. Tem leite?",
    "note": "\"Some\" em frases afirmativas; \"any\" em perguntas e negativas."
   },
   {
    "en": "How many eggs? How much milk?",
    "pt": "Quantos ovos? Quanto leite?",
    "note": "\"Many\" com contáveis (eggs); \"much\" com incontáveis (milk, money)."
   },
   {
    "en": "How much is this shirt? It's 20 dollars.",
    "pt": "Quanto custa esta camisa? Custa 20 dólares.",
    "note": "Para preço: How much is...? / How much are...?"
   },
   {
    "en": "We don't have any bread.",
    "pt": "Não temos pão nenhum.",
    "note": "Negativa + any = nenhum."
   },
   {
    "en": "a lot of money / a lot of people",
    "pt": "muito dinheiro / muitas pessoas",
    "note": "\"A lot of\" funciona com os dois tipos."
   }
  ],
  "tips": [
   "\"Money\" é incontável: \"much money\", nunca \"many moneys\".",
   "Para oferecer algo, use \"some\" mesmo na pergunta: Would you like some coffee?"
  ]
 },
