 "guide": {
  "title": "Números e idade",
  "intro": "Os números de 13 a 19 terminam em \"-teen\" (thirteen, fourteen...). E atenção: para falar a idade o inglês usa o verbo SER/ESTAR (to be), e não \"ter\".",
  "points": [
   {
    "en": "thirteen, fourteen, fifteen",
    "pt": "treze, catorze, quinze",
    "note": "De 13 a 19, todos terminam em \"-teen\". O som forte fica no final: thir-TEEN."
   },
   {
    "en": "How old are you?",
    "pt": "Quantos anos você tem?",
    "note": "Literalmente: \"quão velho você é?\"."
   },
   {
    "en": "I am 20 years old.",
    "pt": "Eu tenho 20 anos.",
    "note": "Em inglês você \"É\" a idade: I am 20. Nunca diga \"I have 20 years\"."
   },
   {
    "en": "What is your phone number?",
    "pt": "Qual é o seu telefone?",
    "note": "Telefone se fala número por número: five, five, two..."
   }
  ],
  "tips": [
   "\"Years old\" pode ser omitido: \"I'm 20\" já está certo.",
   "Cuidado com thirteen (13) e thirty (30): o som forte muda de lugar."
  ]
 },
