  ],
  "guide": {
    "title": "Números e idade",
    "intro": "Os números de 13 a 19 terminam em \"-teen\" (thirteen, fourteen...). E atenção: para falar a idade o inglês usa o verbo SER/ESTAR (to be), e não \"ter\".",
    "points": [
      { "en": "thirteen, fourteen, fifteen", "pt": "treze, catorze, quinze", "note": "De 13 a 19, todos terminam em \"-teen\". O som forte fica no final: thir-TEEN." },
      { "en": "How old are you?", "pt": "Quantos anos você tem?", "note": "Literalmente: \"quão velho você é?\"." },
      { "en": "I am 20 years old.", "pt": "Eu tenho 20 anos.", "note": "Em inglês você \"É\" a idade: I am 20. Nunca diga \"I have 20 years\"." },
      { "en": "What is your phone number?", "pt": "Qual é o seu telefone?", "note": "Telefone se fala número por número: five, five, two..." }
    ],
    "tips": ["\"Years old\" pode ser omitido: \"I'm 20\" já está certo.", "Cuidado com thirteen (13) e thirty (30): o som forte muda de lugar."]
  },
  "lessons": [
    {
      "id": "a1-u3-l1",
      "title": "De 1 a 10",
      "items": [
        { "id": "a1u3l1-1", "type": "match", "pairs": [["one", "1"], ["two", "2"], ["three", "3"], ["four", "4"], ["five", "5"]], "why": "Estes são os números mais usados. \"Two\" se pronuncia \"tchú\", e \"three\" tem o som do \"th\" com a língua entre os dentes." },
        { "id": "a1u3l1-2", "type": "match", "pairs": [["six", "6"], ["seven", "7"], ["eight", "8"], ["nine", "9"], ["ten", "10"]], "why": "\"Eight\" (8) se pronuncia \"êit\" — o \"gh\" é mudo." },
        { "id": "a1u3l1-3", "type": "listen", "en": "Seven", "options": ["7", "6", "9"], "answer": "7", "why": "\"Seven\" = 7. Se pronuncia \"séven\"." },
        { "id": "a1u3l1-4", "type": "meaning", "en": "Three", "options": ["3", "2", "8"], "answer": "3", "why": "\"Three\" = 3. Não confunda com \"two\" (2)." },
        { "id": "a1u3l1-5", "type": "choice", "prompt": "Quanto é 2 + 2?", "en": "Two and two is ___.", "options": ["four", "five", "six"], "answer": "four", "why": "2 + 2 = 4, \"four\". Em inglês podemos dizer \"two and two is four\".", "wrong": { "five": "\"Five\" é 5.", "six": "\"Six\" é 6." } },
        { "id": "a1u3l1-6", "type": "listen", "en": "Eight", "options": ["8", "3", "10"], "answer": "8", "why": "\"Eight\" = 8. O \"gh\" não é pronunciado." }
      ]
    },
    {
      "id": "a1-u3-l2",
      "title": "De 11 a 20",
      "items": [
        { "id": "a1u3l2-1", "type": "match", "pairs": [["eleven", "11"], ["twelve", "12"], ["thirteen", "13"], ["fifteen", "15"], ["twenty", "20"]], "why": "11 e 12 têm nomes próprios (eleven, twelve). A partir do 13, quase todos terminam em \"-teen\"." },
        { "id": "a1u3l2-2", "type": "meaning", "en": "Fourteen", "options": ["14", "40", "4"], "answer": "14", "why": "\"Four\" + \"teen\" = 14. O final \"-teen\" indica os números de 13 a 19." },
        { "id": "a1u3l2-3", "type": "listen", "en": "Twelve", "options": ["12", "20", "2"], "answer": "12", "why": "\"Twelve\" = 12. Não confunda com \"twenty\" (20)." },
        { "id": "a1u3l2-4", "type": "choice", "prompt": "Quanto é 10 + 6?", "en": "Ten and six is ___.", "options": ["sixteen", "six", "seventeen"], "answer": "sixteen", "why": "10 + 6 = 16: \"six\" + \"teen\" = sixteen.", "wrong": { "six": "\"Six\" é só 6.", "seventeen": "\"Seventeen\" é 17." } },
        { "id": "a1u3l2-5", "type": "listen", "en": "Nineteen", "options": ["19", "9", "90"], "answer": "19", "why": "\"Nine\" + \"teen\" = 19. O som forte fica no final: nine-TEEN." },
        { "id": "a1u3l2-6", "type": "meaning", "en": "Eighteen", "options": ["18", "8", "80"], "answer": "18", "why": "\"Eighteen\" = 18. Repare que \"eight\" + \"teen\" fica com um \"t\" só." }
      ]
    },
    {
      "id": "a1-u3-l3",
      "title": "Quantos anos você tem?",
      "items": [
        { "id": "a1u3l3-1", "type": "meaning", "en": "How old are you?", "options": ["Quantos anos você tem?", "Como você está?", "De onde você é?"], "answer": "Quantos anos você tem?", "why": "\"How old\" = quão velho. É assim que se pergunta a idade em inglês." },
        { "id": "a1u3l3-2", "type": "choice", "prompt": "Complete:", "en": "I ___ twenty years old.", "options": ["am", "have", "is"], "answer": "am", "why": "Em inglês a idade usa o verbo to be: I AM twenty. Com \"I\", o to be é \"am\".", "wrong": { "have": "Erro muito comum de brasileiro! Em inglês não se \"tem\" idade: diga \"I am twenty\".", "is": "\"Is\" é para he, she, it; com \"I\" use \"am\"." } },
        { "id": "a1u3l3-3", "type": "build", "pt": "Quantos anos você tem?", "answer": "How old are you", "extra": ["have", "is"], "display": "How old are you?", "why": "How old + are + you. Nada de \"have\": a idade usa o verbo to be." },
        { "id": "a1u3l3-4", "type": "build", "pt": "Ela tem quinze anos.", "answer": "She is fifteen years old", "extra": ["has", "are"], "display": "She is fifteen years old.", "why": "\"She is\" + idade + \"years old\". Lembre: ela \"É\" quinze anos, nunca \"has\"." },
        { "id": "a1u3l3-5", "type": "listen", "en": "He is twelve.", "options": ["Ele tem doze anos.", "Ele tem vinte anos.", "Ela tem doze anos."], "answer": "Ele tem doze anos.", "why": "\"He\" = ele, \"twelve\" = 12. Dá para omitir \"years old\" quando o assunto já é idade." },
        { "id": "a1u3l3-6", "type": "meaning", "en": "What is your phone number?", "options": ["Qual é o seu telefone?", "Qual é o seu nome?", "Quantos anos você tem?"], "answer": "Qual é o seu telefone?", "why": "\"Phone number\" = número de telefone. Na resposta, falamos número por número." },
        { "id": "a1u3l3-7", "type": "choice", "prompt": "Complete:", "en": "How old ___ you?", "options": ["are", "is", "am"], "answer": "are", "why": "Com \"you\" o verbo to be é \"are\" — inclusive nas perguntas.", "wrong": { "is": "\"Is\" é para he, she, it.", "am": "\"Am\" é só para \"I\"." } }
      ]
    }
  ]
}
