   {
    "en": "My birthday is on May 5th.",
    "pt": "Meu aniversário é no dia 5 de maio.",
    "note": "Data exata usa \"on\". Lemos \"May the fifth\"."
   },
   {
    "en": "first, second, third, fourth, fifth",
    "pt": "primeiro, segundo, terceiro, quarto, quinto",
