 "guide": {
  "title": "Comprando roupas",
  "intro": "Numa loja você precisa de poucas frases: perguntar o preço, pedir para experimentar, falar do tamanho e pagar. Com elas você já compra em qualquer lugar.",
  "points": [
   {
    "en": "How much is this T-shirt?",
    "pt": "Quanto custa esta camiseta?",
    "note": "Uma coisa: \"How much IS this...?\". A resposta: \"It's ten dollars.\""
   },
   {
    "en": "How much are these shoes?",
    "pt": "Quanto custam estes sapatos?",
    "note": "Várias coisas: \"How much ARE these...?\". A resposta: \"They're forty dollars.\""
   },
   {
    "en": "Can I try it on?",
    "pt": "Posso experimentar?",
    "note": "\"Try on\" = experimentar roupa. \"It\" vem no meio: try IT on."
   },
   {
    "en": "It is too small.",
    "pt": "É pequeno demais.",
    "note": "\"Too\" + adjetivo = demais: too big, too small, too expensive."
   },
   {
    "en": "Can I pay by card?",
    "pt": "Posso pagar com cartão?",
    "note": "Com cartão: \"by card\". Em dinheiro: \"in cash\"."
   }
  ],
  "tips": [
   "\"Clothes\" (roupas) sempre fica no plural.",
   "\"Jeans\" e \"shoes\" são plurais: these jeans ARE nice."
  ]
 },
 "extra_vocab": [
  {
   "word": "t",
   "reason": "Parte de \"T-shirt\" (A1 na CEFR-J): o validador separa a palavra no hífen."
  },
  {
   "word": "cash",
   "reason": "Pagar \"in cash\" (em dinheiro) é parte básica de fazer compras, objetivo desta unidade A1; na CEFR-J \"cash\" aparece no A2."
