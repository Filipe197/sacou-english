 "guide": {
  "title": "Was e were: falando do passado",
  "intro": "O verbo to be também tem passado: \"was\" e \"were\". Com eles você já conta onde estava e como foi o dia, a festa ou a viagem.",
  "points": [
   {
    "en": "I was at home yesterday.",
    "pt": "Eu estava em casa ontem.",
    "note": "I / he / she / it → was."
   },
   {
    "en": "We were in London last week.",
    "pt": "Nós estávamos em Londres semana passada.",
    "note": "You / we / they → were."
   },
   {
    "en": "How was your trip?",
    "pt": "Como foi a sua viagem?",
    "note": "Pergunta: o verbo vem antes: WAS your trip...? WERE you...?"
   },
   {
    "en": "It wasn't boring. It was great!",
    "pt": "Não foi chato. Foi ótimo!",
    "note": "Negativa: wasn't (was not) / weren't (were not)."
   },
   {
    "en": "There were many people at the beach.",
    "pt": "Tinha muita gente na praia.",
    "note": "Passado de there is / there are: there was / there were."
   },
   {
    "en": "two days ago",
    "pt": "dois dias atrás / há dois dias",
    "note": "\"Ago\" vem DEPOIS do tempo: two days ago, a week ago."
   }
  ],
  "tips": [
   "\"Last\" = passado: last night (ontem à noite), last week, last year.",
   "No Reino Unido férias é \"holiday\"; nos Estados Unidos, \"vacation\"."
  ]
 },
 "extra_vocab": [
  {
   "word": "last",
   "reason": "Indispensável para falar do passado com was/were (last night, last week), objetivo desta unidade A1; na CEFR-J \"last\" aparece no A2."
  }
 ],
