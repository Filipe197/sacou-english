    {
     "id": "a1u2l2-5",
     "type": "build",
     "pt": "Eu sou de Portugal.",
     "answer": "I am from Portugal",
     "extra": [
      "is",
      "where"
     ],
     "display": "I am from Portugal.",
     "why": "Sujeito (I) + verbo (am) + from + lugar. Também pode dizer \"I'm from Portugal\"."
    },
    {
     "id": "a1u2l2-6",
     "type": "listen",
     "en": "She is from London.",
     "options": [
      "Ela é de Londres.",
      "Ele é de Londres.",
      "Ela mora em Londres."
     ],
     "answer": "Ela é de Londres.",
     "why": "\"She\" = ela (\"he\" seria ele). \"Is from\" = é de."
    },
    {
     "id": "a1u2l2-7",
     "type": "choice",
     "prompt": "Complete:",
     "en": "Tom ___ from England.",
