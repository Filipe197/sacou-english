{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/treino.js": {
      "includeFiles": "{src/content/**,content/sources/**}"
    },
    "api/explicar.js": {
      "includeFiles": "{src/content/**,content/sources/**}"
    },
    "api/desafio.js": {
      "includeFiles": "{src/content/**,content/sources/**}"
    }
  },
  "crons": [
    {
      "path": "/api/lembrete",
      "schedule": "0 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/download/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"sacou-english.apk\""
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
