{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/treino.js": {
      "includeFiles": "{src/content/**,content/sources/**}"
    },
    "api/explicar.js": {
      "includeFiles": "{src/content/**,content/sources/**}"
    }
  },
  "crons": [
    {
      "path": "/api/lembrete",
      "schedule": "0 22 * * *"
    }
  ]
}
