{
  "name": "sacou-english",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-games.mjs",
    "build": "node scripts/validate-content.mjs && node scripts/coverage-cefr.mjs && node scripts/validate-games.mjs && node scripts/check-api.mjs && vite build",
    "test": "node tests/unit/trail-rules.mjs && node tests/e2e/smoke.mjs && node tests/e2e/recovery.mjs",
    "test:recovery": "node tests/e2e/recovery.mjs",
    "preview": "vite preview",
    "build:android": "vite build --mode android --outDir dist-android && node scripts/android-web.mjs && npx cap sync android",
    "apk": "npm run build:android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor-community/text-to-speech": "^4.1.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.3",
    "@lottiefiles/dotlottie-react": "^0.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^25.17.0",
    "vite": "^5.4.0"
  }
}
